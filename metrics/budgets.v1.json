      "enforcement": "device-required"
    },
    {
      "id": "allocations.gen0_collections_per_60s",
      "category": "allocations",
      "unit": "collections/60s",
      "comparison": "maximum",
      "target": 0,
      "failureThreshold": 0,
      "scope": "60 segundos de gameplay da cena de referência",
      "collector": "contadores GC do runtime .NET no aparelho",
      "enforcement": "device-required"
    },
    {
      "id": "cpu.editor_frame_time_ms",
      "category": "cpu",
      "unit": "ms/frame",
      "comparison": "maximum",
      "target": 16.6,
      "failureThreshold": 20.0,
      "scope": "editor com cena de referência em aparelho classe A",
      "collector": "profiler CPU/frame pacing do runtime",
      "enforcement": "device-required"
    },
    {
      "id": "gpu.runtime_frame_time_ms",
      "category": "gpu",
      "unit": "ms/frame",
      "comparison": "maximum",
      "target": 16.6,
      "failureThreshold": 16.6,
