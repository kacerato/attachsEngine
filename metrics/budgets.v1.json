      "enforcement": "device-required"
    },
    {
      "id": "energy.sustained_power_watts_30m",
      "category": "energy",
      "unit": "W",
      "comparison": "maximum",
      "target": 4.0,
      "failureThreshold": 5.0,
      "scope": "30 minutos de edição contínua em aparelho classe A",
