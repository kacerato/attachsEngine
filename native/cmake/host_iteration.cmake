# Host-only build policy. Explicit targets continue to work; the default build
# does not compile every acceptance runner, preview and benchmark.
option(AETHER_HOST_TOOLS_IN_ALL "Include host validation tools in the default build" OFF)
get_property(astra_host_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
set(astra_host_checks)
foreach(astra_target IN LISTS astra_host_targets)
  get_target_property(astra_type ${astra_target} TYPE)
  if(astra_type STREQUAL "EXECUTABLE" AND
      NOT astra_target STREQUAL "aether_component_contract_probe")
    if(NOT AETHER_HOST_TOOLS_IN_ALL)
      set_property(TARGET ${astra_target} PROPERTY EXCLUDE_FROM_ALL TRUE)
    endif()
    if(astra_target MATCHES "^aether_.*tests$")
      list(APPEND astra_host_checks ${astra_target})
    endif()
  endif()
endforeach()
if(TARGET aether_animation_authoring_sdk_bridge AND NOT AETHER_HOST_TOOLS_IN_ALL)
  set_property(TARGET aether_animation_authoring_sdk_bridge PROPERTY EXCLUDE_FROM_ALL TRUE)
endif()
add_custom_target(aether_host_checks DEPENDS ${astra_host_checks})

# Each shared fixture remains its own object target: building one focused runner
# must not compile unrelated fixtures. These consumers have the same repository
# definition and engine dependencies. Only debug-info density is normalized.
function(astra_share_fixture fixture)
  set(object_target astra_fixture_${fixture})
  set(source "${CMAKE_CURRENT_SOURCE_DIR}/../tests/native/${fixture}.cpp")
  cmake_path(NORMAL_PATH source)
  add_library(${object_target} OBJECT EXCLUDE_FROM_ALL "${source}")
  target_include_directories(${object_target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../tests/native")
  target_compile_definitions(${object_target} PRIVATE AETHER_REPOSITORY_ROOT="${CMAKE_SOURCE_DIR}/..")
  target_link_libraries(${object_target} PRIVATE aether_core aether_platform aether_rendergraph
    aether_renderer aether_rhi aether_ui aether_editor aether_physics aether_water_runtime
    aether_transform aether_resources aether_codecs aether_astcenc)
  if(MINGW)
    target_compile_options(${object_target} PRIVATE -Wa,-mbig-obj -g1)
  endif()
  foreach(consumer IN LISTS ARGN)
    get_target_property(sources ${consumer} SOURCES)
    set(kept)
    set(found FALSE)
    foreach(candidate IN LISTS sources)
      cmake_path(ABSOLUTE_PATH candidate BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE absolute)
      if(absolute STREQUAL source)
        set(found TRUE)
      else()
        list(APPEND kept "${candidate}")
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "Shared fixture ${fixture} is absent from ${consumer}")
    endif()
    set_property(TARGET ${consumer} PROPERTY SOURCES "${kept}")
    # Direct objects preserve static test registration; a static archive could
    # silently discard fixtures whose only entry point is their constructor.
    target_sources(${consumer} PRIVATE $<TARGET_OBJECTS:${object_target}>)
  endforeach()
endfunction()

