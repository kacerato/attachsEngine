#version 450
// Avaliação da Exposure do HDRP 17 (Exposure.compute): Automatic usa a média
// ponderada do log da luminância; Automatic Histogram descarta os percentis
// fora da faixa. EV100 = log2(L*100/K), K = cinza médio * 100. Depois:
// adapta(EV100 - compensação) e limita a [Limit Min, Limit Max].
layout(local_size_x=1) in;
layout(set=0,binding=1,std430) readonly buffer Histogram { uint count[64]; uint sum[64]; } histogram;
// ev: EV de clareamento que o pós aplica (exp2); ev100: exposição adaptada da
// câmera (o "anterior" do quadro seguinte); meteredEv100: medição crua.
layout(set=0,binding=2,std430) buffer ExposureState { float ev; float ev100; float meteredEv100; uint valid; } state;
layout(push_constant) uniform ExposurePush {
  vec4 sourceSize;
  vec4 viewport;
  vec4 metering; // limit min EV100, limit max EV100, target mid grey, base exposure multiplier
  vec4 adaptation; // dt seconds, speed dark->light, speed light->dark, reset
  vec4 range; // low/high fraction, metering mode, evaluate (1 auto, 2 histogram)
  vec4 extra; // compensation EV, progressive, reserved
} exposure;
void main() {
  float total=0;
  for(uint i=0;i<64;++i) total+=float(histogram.count[i]);
  if(total<=0) {state.ev=0;state.ev100=0;state.meteredEv100=0;state.valid=0;return;}
  bool histogramMode=exposure.range.w>1.5;
  float low=histogramMode?total*exposure.range.x:0.0;
  float high=histogramMode?total*exposure.range.y:total;
  float prefix=0,selected=0,sumPosition=0;
  for(uint i=0;i<64;++i) {
    float count=float(histogram.count[i]);
    float amount=max(0.0,min(prefix+count,high)-max(prefix,low));
    if(count>0) sumPosition+=amount*float(histogram.sum[i])/(count*4095.0);
    selected+=amount;prefix+=count;
  }
  if(selected<=0) {state.ev=0;state.ev100=0;state.meteredEv100=0;state.valid=0;return;}
  float logLuminance=(sumPosition/selected)*40.0-16.0;
  float metered=logLuminance-log2(exposure.metering.z);
  float target=metered-exposure.extra.x;
  float adapted=target;
  if(state.valid!=0u&&exposure.adaptation.w<0.5&&exposure.extra.y>0.5) {
    // ComputeLuminanceAdaptation (SRP Core): decaimento exponencial em EV100.
    float delta=target-state.ev100;
    float speed=delta>0.0?exposure.adaptation.y:exposure.adaptation.z;
    adapted=state.ev100+delta*(1.0-exp2(-max(exposure.adaptation.x,0.0)*speed));
  }
  adapted=clamp(adapted,exposure.metering.x,exposure.metering.y);
  state.meteredEv100=metered;
  state.ev100=adapted;
  state.ev=-adapted-log2(1.2);
  state.valid=1;
}
