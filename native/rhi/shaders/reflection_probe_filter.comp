#version 450
// PK-6: filtro de uma Reflection Probe capturada.
//
// Entrada: o cubemap das seis faces (com mips por blit), na convenção de faces
// do Vulkan. Saída: um mip do octaedro do atlas de sondas. O mip base é o
// espelho (rugosidade 0, uma busca); os seguintes são o pré-filtro GGX do
// split-sum para rugosidade (mip-base)/(último-base), por amostragem de
// importância FILTRADA (Křivánek e Colbert, GPU Gems 3 cap. 20): cada amostra
// lê o mip do cubo cujo texel cobre o ângulo sólido dela, o que tira o ruído
// com 32 amostras. É a mesma convolução que o reflexo do céu já usa.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform samplerCube captured;
layout(set=0,binding=1,rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform FilterPush {
  uint side;        // lado do mip de saída
  uint faceSize;    // lado da face capturada no mip 0
  float roughness;  // rugosidade deste mip (0 no mip base)
  float sourceLods; // mips do cubo menos 1
  float clampValue; // 1 sem HDR, 0 com HDR
  float intensity;  // reservado (a intensidade é aplicada no fragmento)
  float reserved0,reserved1;
} push;

const float PI=3.14159265358979;
vec3 octahedralDecode(vec2 uv) {
  vec2 f=uv*2.0-1.0;
  vec3 n=vec3(f.x,1.0-abs(f.x)-abs(f.y),f.y);
  if(n.y<0.0) n.xz=(1.0-abs(n.zx))*mix(vec2(-1.0),vec2(1.0),greaterThanEqual(n.xz,vec2(0.0)));
  return normalize(n);
}
float radicalInverse(uint bits) {
  bits=(bits<<16u)|(bits>>16u);
  bits=((bits&0x55555555u)<<1u)|((bits&0xAAAAAAAAu)>>1u);
  bits=((bits&0x33333333u)<<2u)|((bits&0xCCCCCCCCu)>>2u);
  bits=((bits&0x0F0F0F0Fu)<<4u)|((bits&0xF0F0F0F0u)>>4u);
  bits=((bits&0x00FF00FFu)<<8u)|((bits&0xFF00FF00u)>>8u);
  return float(bits)*2.3283064365386963e-10;
}
void main() {
  uvec2 texel=gl_GlobalInvocationID.xy;
  if(texel.x>=push.side||texel.y>=push.side) return;
  vec3 n=octahedralDecode((vec2(texel)+0.5)/float(push.side));
  vec3 color;
  if(push.roughness<=0.0) {
    color=textureLod(captured,n,0.0).rgb;
  } else {
    float a=push.roughness*push.roughness;
    vec3 up=abs(n.y)<0.999?vec3(0,1,0):vec3(1,0,0);
    vec3 tx=normalize(cross(up,n)),ty=cross(n,tx);
    const uint samples=32u;
    float texelSolidAngle=4.0*PI/(6.0*float(push.faceSize)*float(push.faceSize));
    vec3 sum=vec3(0.0);float weight=0.0;
    for(uint i=0u;i<samples;++i) {
      vec2 xi=vec2(float(i)/float(samples),radicalInverse(i));
      float phi=2.0*PI*xi.x;
      float cosTheta=sqrt((1.0-xi.y)/(1.0+(a*a-1.0)*xi.y));
      float sinTheta=sqrt(max(1.0-cosTheta*cosTheta,0.0));
      vec3 h=tx*(cos(phi)*sinTheta)+ty*(sin(phi)*sinTheta)+n*cosTheta;
      vec3 l=2.0*dot(n,h)*h-n;
      float nl=dot(n,l);
      if(nl<=0.0) continue;
      // N=V=R: pdf(l) = D(h)/4.
      float d=a*a/(PI*pow(cosTheta*cosTheta*(a*a-1.0)+1.0,2.0));
      float sampleSolidAngle=1.0/(float(samples)*max(d*0.25,1e-6));
      float lod=clamp(0.5*log2(sampleSolidAngle/texelSolidAngle)+1.0,0.0,push.sourceLods);
      sum+=textureLod(captured,l,lod).rgb*nl;
      weight+=nl;
    }
    color=weight>0.0?sum/weight:textureLod(captured,n,push.sourceLods).rgb;
  }
  color=max(color,vec3(0.0));
  if(push.clampValue>0.5) color=min(color,vec3(1.0));
  // Meia precisão satura em 65504; o sol fica no maior finito, nunca infinito.
  color=min(color,vec3(60000.0));
  imageStore(target,ivec2(texel),vec4(color,1.0));
}
