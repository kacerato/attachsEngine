<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Aether.Tests</AssemblyName>
    <RootNamespace>Aether.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../managed/Aether.Core/Aether.Core.csproj" />
    <ProjectReference Include="../../managed/Aether.Flow/Aether.Flow.csproj" />
    <ProjectReference Include="../../managed/Aether.Scene/Aether.Scene.csproj" />
    <ProjectReference Include="../../managed/Aether.Rendering/Aether.Rendering.csproj" />
  </ItemGroup>

  <!--
    Item 0.2 (PoC-D, hot reload): HotReloadHostTests compila C# em memória via Roslyn para simular
    o resultado de uma edição do usuário virando um assembly novo — mesmo mecanismo de
    Aether.Analyzers.csproj (Roslyn já vem dentro do SDK, sem NuGet), mas aqui as DLLs precisam
    estar no diretório de saída (Private não desligado) porque o PROCESSO DE TESTE as carrega em
    runtime para compilar, não o MSBuild em tempo de build.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Testes de Aether.Physics carregam a biblioteca nativa "aether_physics" via [LibraryImport]
    em runtime — precisa estar ao lado do executável de teste. Não há build nativo automático
    aqui de propósito (dotnet build não deveria depender de ter cmake/ninja disponível para
    compilar C#): o binário é procurado só se já existir, no diretório de build nativo padrão do
    projeto (ver "cmake -S native -B build/native ..." em docs/CONVENCOES.md — alvo
    aether_physics_shared). Ausente, os testes de física retornam cedo e passam vazios (ver
    NativeLibraryAvailable() em PhysicsTests.cs) em vez de falhar.
  -->
  <ItemGroup>
    <None Include="../../build/native/aether_physics.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/aether_physics.dll')" />
    <None Include="../../build/native/libaether_physics.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/libaether_physics.so')" />
    <None Include="../../build/native/aether_transform.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/aether_transform.dll')" />
    <None Include="../../build/native/libaether_transform.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/libaether_transform.so')" />
    <None Include="../../build/native/aether_resources.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/aether_resources.dll')" />
    <None Include="../../build/native/libaether_resources.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/libaether_resources.so')" />
  </ItemGroup>
</Project>
