<?xml version="1.0" encoding="utf-8"?>
<!-- O núcleo não usa NuGet. O compilador Astra fixa Roslyn e suas dependências;
     o primeiro restore da ferramenta de autoria precisa baixar estes pacotes. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.CodeAnalysis.*" />
      <package pattern="System.Collections.Immutable" />
      <package pattern="System.Reflection.Metadata" />
      <package pattern="Microsoft.NET.ILLink.Tasks" />
    </packageSource>
  </packageSourceMapping>
</configuration>
